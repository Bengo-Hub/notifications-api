# Notifications Service environment template
# Env var names are the full envconfig tag (no namespace prefix).
# Uses envconfig:"" on parent structs so tags ARE the env var names.

APP_NAME=notifications-app
APP_ENV=development
APP_VERSION=0.1.0

HTTP_HOST=0.0.0.0
HTTP_PORT=4000
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
# TLS configuration for HTTPS (mkcert certificates) - local development only
# Uncomment and set paths to enable HTTPS
HTTP_TLS_CERT_FILE=./config/certs/notifications.codevertex.local.pem
HTTP_TLS_KEY_FILE=./config/certs/notifications.codevertex.local-key.pem
HTTP_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

POSTGRES_URL=postgres://postgres:postgres@localhost:5432/notifications?sslmode=disable
POSTGRES_MAX_OPEN_CONNS=20
POSTGRES_MAX_IDLE_CONNS=10
POSTGRES_CONN_MAX_LIFETIME=30m

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_DIAL_TIMEOUT=5s

EVENTS_BUS=nats
EVENTS_NATS_URL=nats://localhost:4222
EVENTS_NATS_STREAM=notifications
EVENTS_NATS_SUBJECT=notifications.events
EVENTS_NATS_ACK_WAIT=30s

PROVIDERS_SENDGRID_API_KEY=
PROVIDERS_MAILGUN_DOMAIN=
PROVIDERS_MAILGUN_API_KEY=
PROVIDERS_TWILIO_ACCOUNT_SID=
PROVIDERS_TWILIO_AUTH_TOKEN=
PROVIDERS_AFRICAS_TALKING_KEY=
PROVIDERS_AFRICAS_TALKING_USERNAME=
PROVIDERS_VONAGE_API_KEY=
PROVIDERS_VONAGE_API_SECRET=
PROVIDERS_PLIVO_AUTH_ID=
PROVIDERS_PLIVO_AUTH_TOKEN=
PROVIDERS_SMTP_HOST=localhost
PROVIDERS_SMTP_PORT=1025
PROVIDERS_SMTP_USERNAME=
PROVIDERS_SMTP_PASSWORD=
PROVIDERS_SMTP_FROM=no-reply@codevertexitsolutions.com
PROVIDERS_SMTP_STARTTLS=false
PROVIDERS_FCM_SERVICE_ACCOUNT=
PROVIDERS_APNS_CERT=
PROVIDERS_APNS_KEY=
PROVIDERS_DEFAULT_EMAIL_SENDER=CodeVertex <hello@codevertexitsolutions.com>
PROVIDERS_DEFAULT_SMS_SENDER=CodeVertex
PROVIDERS_DEFAULT_PUSH_TOPIC=general

TEMPLATES_DIRECTORY=./templates
TEMPLATES_CACHE_TTL=5m

# Optional shared API key for protecting /v1 endpoints
SECURITY_API_KEY=

# Auth Service SSO (JWT) settings
SECURITY_REQUIRE_JWT=true
SECURITY_JWKS_URL=https://sso.codevertexitsolutions.com/api/v1/.well-known/jwks.json
SECURITY_JWT_ISSUER=https://sso.codevertexitsolutions.com
SECURITY_JWT_AUDIENCE=codevertex

# API key validation database URL (optional, enables API key authentication)
# Set to auth-service database URL to enable API key validation
# SECURITY_API_KEY_DB_URL=postgres://postgres:postgres@localhost:5432/auth?sslmode=disable

# Provider secrets encryption at rest (32-byte key, base64 or raw). If set, platform provider api_key/password/auth_token are stored encrypted.
SECURITY_ENCRYPTION_KEY=

# Enable background worker process (default: false, worker runs separately)
# ENABLE_WORKER=true
